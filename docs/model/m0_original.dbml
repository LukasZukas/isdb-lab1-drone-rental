// M0 - ORIGINAL (unfragmented) database model - SkyRent drone rental
// Open in https://dbdiagram.io (paste this file) to view / edit the diagram.

Project skyrent_original {
  database_type: 'PostgreSQL'
  Note: 'Original model before fragmentation. UUID keys for objects shared by M1/M2. 11 tables; drone has 14 attributes and is split vertically.'
}

Table country [headercolor: #7f8c8d] {
  country_code char(2) [pk]
  name varchar(60) [not null, unique]
  currency_code char(3) [not null]
  phone_prefix varchar(5) [not null]
  Note: 'Classifier'
}

Table drone_category [headercolor: #7f8c8d] {
  category_id integer [pk]
  name varchar(60) [not null, unique]
  description text [not null]
  Note: 'Classifier'
}

Table drone_model [headercolor: #7f8c8d] {
  model_id integer [pk]
  category_id integer [not null, ref: > drone_category.category_id]
  manufacturer varchar(60) [not null]
  model_name varchar(80) [not null]
  max_flight_time_min smallint [not null]
  max_payload_kg numeric(5,2) [not null]
  max_range_km numeric(5,1) [not null]
  camera_mp numeric(4,1)
  weight_g integer [not null]
  launch_year smallint [not null]
  Note: 'Classifier'
}

Table branch [headercolor: #8e44ad] {
  branch_id uuid [pk]
  name varchar(80) [not null, unique]
  city varchar(60) [not null]
  country_code char(2) [not null, ref: > country.country_code, note: 'horizontal fragmentation attribute']
  address varchar(120) [not null]
  phone varchar(20) [not null]
  email varchar(120) [not null]
  opened_on date [not null]
}

Table customer [headercolor: #2471a3] {
  customer_id integer [pk]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  email varchar(120) [not null, unique]
  phone varchar(20) [not null]
  birth_date date [not null]
  country_code char(2) [not null, ref: > country.country_code]
  home_branch_id uuid [not null, ref: > branch.branch_id]
  pilot_license_no varchar(30) [not null, unique]
  license_class varchar(5) [not null, note: 'A1/A3 | A2 | STS']
  registered_at timestamp [not null]
}

Table drone [headercolor: #d35400] {
  drone_id uuid [pk]
  model_id integer [not null, ref: > drone_model.model_id]
  branch_id uuid [not null, ref: > branch.branch_id]
  serial_number varchar(40) [not null, unique]
  purchase_date date [not null]
  purchase_price numeric(10,2) [not null]
  daily_rate numeric(8,2) [not null]
  deposit_amount numeric(8,2) [not null]
  status varchar(12) [not null, note: 'available | rented | maintenance | retired']
  firmware_version varchar(20) [not null]
  total_flight_hours numeric(7,1) [not null]
  battery_cycles integer [not null]
  last_inspection_date date
  condition varchar(10) [not null, note: 'excellent | good | fair | poor']
  Note: '14 attributes - split VERTICALLY: commercial part -> M1 (PostgreSQL), technical part -> M2 (document DB)'
}

Table rental [headercolor: #2471a3] {
  rental_id uuid [pk]
  customer_id integer [not null, ref: > customer.customer_id]
  drone_id uuid [not null, ref: > drone.drone_id]
  branch_id uuid [not null, ref: > branch.branch_id]
  start_date date [not null]
  end_date date [not null]
  total_price numeric(10,2) [not null]
  status varchar(10) [not null, note: 'reserved | active | completed | cancelled']
}

Table payment [headercolor: #2471a3] {
  payment_id integer [pk]
  rental_id uuid [not null, ref: > rental.rental_id]
  amount numeric(10,2) [not null]
  method varchar(15) [not null]
  payment_type varchar(15) [not null]
  paid_at timestamp [not null]
}

Table employee [headercolor: #1e8449] {
  employee_id uuid [pk]
  branch_id uuid [not null, ref: > branch.branch_id]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  email varchar(120) [not null, unique]
  role varchar(20) [not null]
  certification varchar(60)
  hired_on date [not null]
}

Table maintenance [headercolor: #1e8449] {
  maintenance_id integer [pk]
  drone_id uuid [not null, ref: > drone.drone_id]
  employee_id uuid [not null, ref: > employee.employee_id]
  maintenance_date date [not null]
  maintenance_type varchar(25) [not null]
  description text [not null]
  cost numeric(8,2) [not null]
  downtime_hours numeric(5,1) [not null]
}

Table flight_log [headercolor: #1e8449] {
  flight_id integer [pk]
  drone_id uuid [not null, ref: > drone.drone_id]
  rental_id uuid [ref: > rental.rental_id]
  started_at timestamp [not null]
  duration_min smallint [not null]
  max_altitude_m smallint [not null]
  distance_km numeric(6,2) [not null]
  battery_used_pct smallint [not null]
  incident_reported boolean [not null]
}

TableGroup classifiers_replicated {
  country
  drone_category
  drone_model
}

TableGroup M1_customers_rentals_postgresql {
  branch
  customer
  rental
  payment
}

TableGroup M2_fleet_maintenance_document_db {
  employee
  maintenance
  flight_log
}

TableGroup split_vertically {
  drone
}
